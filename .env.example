PORT=3000
AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.3
# xAI uses shared Turso storage below to enforce $0.25/day and $4 total
# across the local preview and hosted deployment. No automatic model fallback.
# Optional free provider: set AI_PROVIDER=openrouter to select it explicitly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Enable only after adding the selected provider key and storage credentials.
LIVE_AI_ENABLED=false
# Optional legacy OpenAI provider: set AI_PROVIDER=openai and verified rates below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
APP_ORIGIN=http://localhost:3000
# Blank uses a durable random secret generated in SQLite.
SESSION_SECRET=
DATABASE_PATH=./data/threadline.sqlite
# Shared storage for hosted deployments and paid xAI local previews.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Only required for the legacy OpenAI provider.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
