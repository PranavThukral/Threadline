{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "outDir": "dist/api",
    "types": ["node", "react", "react-dom"],
    "resolveJsonModule": true
  },
  "include": ["src", "scripts", "vite.config.ts", "tests"]
}
