{
  "name": "threadline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts --dev\" \"vite\"",
    "build": "pnpm fixtures:bundle && tsc -p tsconfig.json && vite build",
    "start": "node dist/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check index.html package.json vercel.json *.config.js api src scripts tests docs README.md",
    "test": "vitest run",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "smoke:built": "node scripts/smoke-built.mjs",
    "benchmark:built": "node scripts/benchmark.mjs",
    "fixtures:bundle": "tsx scripts/bundle-fixtures.ts && prettier --write src/recorded-bundle.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.2",
    "@fastify/static": "^10.1.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/krub": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@openrouter/sdk": "^1.4.25",
    "eventsource-parser": "^3.0.6",
    "fastify": "^5.4.0",
    "lucide-react": "^0.544.0",
    "openai": "^7.28.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  }
}
